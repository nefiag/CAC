# Generate with: openssl rand -base64 36
POSTGRES_PASSWORD=replace-with-a-long-random-password
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-initial-password

# Cloudflare Zero Trust tunnel token. Configure public hostname
# cac.bstks.cn -> http://frontend:80 in the tunnel dashboard.
CLOUDFLARE_TUNNEL_TOKEN=replace-with-cloudflare-tunnel-token

# Optional: bank-statement AI classification.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
